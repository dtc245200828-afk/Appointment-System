logs/
data/

# Chứng chỉ tự sinh (đã có volume nginx_certs)
deployment/nginx/certs/
*.pem
*.key

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Docker override cá nhân
docker-compose.override.yml
