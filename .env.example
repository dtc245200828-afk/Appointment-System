# =====================================================================
# Mẫu biến môi trường - COPY sang .env rồi đổi toàn bộ giá trị bí mật
#   cp .env.example .env      (hoặc: node scripts/generate-secrets.js)
# KHÔNG commit file .env lên Git.
# =====================================================================

# ---------------- Ứng dụng ----------------
NODE_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
MAX_ACTIVE_APPOINTMENTS_PER_USER=5

# JWT: bắt buộc >= 32 ký tự, sinh bằng `openssl rand -base64 48`
JWT_SECRET=change-me-please-use-openssl-rand-base64-48-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ---------------- PostgreSQL ----------------
POSTGRES_DB=appointment
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change-me-super-admin-password
# Mật khẩu của role tối thiểu quyền dùng cho ứng dụng (app_user)
APP_DB_PASSWORD=change-me-app-user-password
# Mật khẩu của role chỉ đọc dùng cho postgres_exporter (exporter_user)
EXPORTER_DB_PASSWORD=change-me-exporter-password
POSTGRES_PORT=5432

# ---------------- Nginx / cổng public ----------------
HTTP_PORT=80
HTTPS_PORT=443
NGINX_SERVER_NAME=localhost

# ---------------- pgAdmin ----------------
PGADMIN_DEFAULT_EMAIL=admin@appointment.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050

# ---------------- Monitoring ----------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ROOT_URL=http://localhost:3001
